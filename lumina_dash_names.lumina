fn a-plus-b(a int b int) int do
    let res int = add(a b)
    ret res
end

fn hundred-doors() do
    let doors array bool = new array bool(101)
    mut i int = 1
    loop do
        let i-done bool = greater-than(i 100)
        if i-done do
            break
        end
        mut j int = i
        loop do
            let j-done bool = greater-than(j 100)
            if j-done do
                break
            end
            let current bool = index(doors j)
            let toggled bool = not(current)
            set-index(doors j toggled)
            j = add(j i)
        end
        i = add(i 1)
    end
end

