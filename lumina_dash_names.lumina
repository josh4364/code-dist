fn launch-rocket() do
    mut t int = 10
    loop do
        let done bool = less-than(t 0)
        if done do
            break
        end
        print("T-minus ")
        print(t)
        t = subtract(t 1)
    end
    print("Liftoff!")
end

fn nkt-law(t f64 t-env f64 t-init f64 k f64) f64 do
    let diff f64 = subtract(t-init t-env)
    let kt f64 = multiply(k t)
    let neg-kt f64 = subtract(0.0 kt)
    let exponent f64 = exp(neg-kt)
    let term2 f64 = multiply(diff exponent)
    let result f64 = add(t-env term2)
    ret result
end

fn lambda-identity(x int) int do
    ret x
end

fn nautical-bell(h int m int) int do
    let h-mod int = remainder(h 4)
    let h-half int = multiply(h-mod 2)
    let is-half bool = greater-than(m 29)
    mut bells int = h-half
    if is-half do
        bells = add(bells 1)
    end
    let is-zero bool = equal(bells 0)
    if is-zero do
        ret 8
    else
        ret bells
    end
end

fn is-prime(n int) bool do
    let small bool = less-than(n 2)
    if small do
        ret false
    end
    mut i int = 2
    loop do
        let i-sq int = multiply(i i)
        let high bool = greater-than(i-sq n)
        if high do
            ret true
        end
        let mod int = remainder(n i)
        let div bool = equal(mod 0)
        if div do
            ret false
        end
        i = add(i 1)
    end
end

fn grad-check(p1 int p2 int) int do
    let res int = subtract(p1 p2)
    ret res
end

fn draw-death-star(r int) do
    mut y int = subtract(0 r)
    loop do
        let y-done bool = greater-than(y r)
        if y-done do
            ret
        end
        y = add(y 1)
    end
end

import "std/os"
fn start-server() do
    let fd int = socket-create()
    let success bool = socket-bind(fd 65432)
    if success do
        socket-listen(fd)
    end
end

