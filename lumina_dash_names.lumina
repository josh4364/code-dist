fn fib(n int) int do
    mut a int = 0
    mut b int = 1
    mut i int = 0
    loop do
        let done bool = equal(i n)
        if done do
            ret a
        end
        let temp int = a
        a = b
        b = add(temp b)
        i = add(i 1)
    end
end

fn factorial(n int) int do
    let is-zero bool = equal(n 0)
    if is-zero do
        ret 1
    end
    let n-minus-1 int = subtract(n 1)
    let sub-fact int = factorial(n-minus-1)
    let result int = multiply(n sub-fact)
    ret result
end

fn bottles-of-beer() do
    mut i int = 99
    loop do
        let finished bool = equal(i 0)
        if finished do
            ret
        end
        print(i)
        print(" bottles of beer on the wall, ")
        print(i)
        print(" bottles of beer. Take one down, pass it around, ")
        i = subtract(i 1)
        print(i)
        print(" bottles of beer on the wall.")
    end
end

fn bubble-sort(arr array int) do
    let n int = length(arr)
    mut i int = 0
    loop do
        let i-done bool = equal(i n)
        if i-done do
            ret
        end
        mut j int = 0
        let limit int = subtract(n i)
        let limit-final int = subtract(limit 1)
        loop do
            let j-done bool = equal(j limit-final)
            if j-done do
                break
            end
            let j-plus-1 int = add(j 1)
            let val-a int = index(arr j)
            let val-b int = index(arr j-plus-1)
            let swap bool = greater-than(val-a val-b)
            if swap do
                set-index(arr j val-b)
                set-index(arr j-plus-1 val-a)
            end
            j = add(j 1)
        end
        i = add(i 1)
    end
end

fn fizzbuzz() do
    mut i int = 1
    loop do
        let done bool = greater-than(i 100)
        if done do
            ret
        end
        let mod15 int = remainder(i 15)
        let is-fizzbuzz bool = equal(mod15 0)
        if is-fizzbuzz do
            print("FizzBuzz")
        else
            let mod3 int = remainder(i 3)
            let is-fizz bool = equal(mod3 0)
            if is-fizz do
                print("Fizz")
            else
                let mod5 int = remainder(i 5)
                let is-buzz bool = equal(mod5 0)
                if is-buzz do
                    print("Buzz")
                else
                    print(i)
                end
            end
        end
        i = add(i 1)
    end
end

