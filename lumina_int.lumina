fn fib(n int) int do
    mut a int = 0
    mut b int = 1
    mut i int = 0
    loop do
        let done bool = equal(i n)
        if done do
            ret a
        end
        let temp int = a
        a = b
        b = add(temp b)
        i = add(i 1)
    end
end

fn factorial(n int) int do
    let is_zero bool = equal(n 0)
    if is_zero do
        ret 1
    end
    let n_minus_1 int = subtract(n 1)
    let sub_fact int = factorial(n_minus_1)
    let result int = multiply(n sub_fact)
    ret result
end

fn bottles_of_beer() do
    mut i int = 99
    loop do
        let finished bool = equal(i 0)
        if finished do
            ret
        end
        print(i)
        print(" bottles of beer on the wall, ")
        print(i)
        print(" bottles of beer. Take one down, pass it around, ")
        i = subtract(i 1)
        print(i)
        print(" bottles of beer on the wall.")
    end
end

fn bubble_sort(arr array int) do
    let n int = length(arr)
    mut i int = 0
    loop do
        let i_done bool = equal(i n)
        if i_done do
            ret
        end
        mut j int = 0
        let limit int = subtract(n i)
        let limit_final int = subtract(limit 1)
        loop do
            let j_done bool = equal(j limit_final)
            if j_done do
                break
            end
            let j_plus_1 int = add(j 1)
            let val_a int = index(arr j)
            let val_b int = index(arr j_plus_1)
            let swap bool = greater_than(val_a val_b)
            if swap do
                set_index(arr j val_b)
                set_index(arr j_plus_1 val_a)
            end
            j = add(j 1)
        end
        i = add(i 1)
    end
end

fn fizzbuzz() do
    mut i int = 1
    loop do
        let done bool = greater_than(i 100)
        if done do
            ret
        end
        let mod15 int = remainder(i 15)
        let is_fizzbuzz bool = equal(mod15 0)
        if is_fizzbuzz do
            print("FizzBuzz")
        else
            let mod3 int = remainder(i 3)
            let is_fizz bool = equal(mod3 0)
            if is_fizz do
                print("Fizz")
            else
                let mod5 int = remainder(i 5)
                let is_buzz bool = equal(mod5 0)
                if is_buzz do
                    print("Buzz")
                else
                    print(i)
                end
            end
        end
        i = add(i 1)
    end
end

