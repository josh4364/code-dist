fn nautical_bell(h int m int) int do
    let h_mod int = remainder(h 4)
    let h_half int = multiply(h_mod 2)
    let is_half bool = greater_than(m 29)
    mut bells int = h_half
    if is_half do
        bells = add(bells 1)
    end
    let is_zero bool = equal(bells 0)
    if is_zero do
        ret 8
    else
        ret bells
    end
end

fn is_prime(n int) bool do
    let small bool = less_than(n 2)
    if small do
        ret false
    end
    mut i int = 2
    loop do
        let i_sq int = multiply(i i)
        let high bool = greater_than(i_sq n)
        if high do
            ret true
        end
        let mod int = remainder(n i)
        let div bool = equal(mod 0)
        if div do
            ret false
        end
        i = add(i 1)
    end
end

fn grad_check(p1 int p2 int) int do
    let res int = subtract(p1 p2)
    ret res
end

fn draw_death_star(r int) do
    mut y int = subtract(0 r)
    loop do
        let y_done bool = greater_than(y r)
        if y_done do
            ret
        end
        y = add(y 1)
    end
end

import "std/os"
fn start_server() do
    let fd int = socket_create()
    let success bool = socket_bind(fd 65432)
    if success do
        socket_listen(fd)
    end
end

