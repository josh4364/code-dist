; 14. Nautical bell
fn nautical_bell(h i32 m i32) i32 do
    let h_mod i32 = remainder(h 4)
    let h_half i32 = multiply(h_mod 2)
    let is_half bool = greater_than(m 29)
    mut bells i32 = h_half
    if is_half do
        bells = add(bells 1)
    end
    let is_zero bool = equal(bells 0)
    if is_zero do
        ret 8
    else
        ret bells
    end
end

; 15. Earliest difference between primes
fn is_prime(n i32) bool do
    let small bool = less_than(n 2)
    if small do
        ret false
    end
    mut i i32 = 2
    loop do
        let i_sq i32 = multiply(i i)
        let high bool = greater_than(i_sq n)
        if high do
            ret true
        end
        let mod i32 = remainder(n i)
        let div bool = equal(mod 0)
        if div do
            ret false
        end
        i = add(i 1)
    end
end

; 16. Canny edge detector (Gradient logic)
fn grad_check(p1 i32 p2 i32) i32 do
    let res i32 = subtract(p1 p2)
    ret res
end

; 17. Death Star
fn draw_death_star(r i32) do
    mut y i32 = subtract(0 r)
    loop do
        let y_done bool = greater_than(y r)
        if y_done do
            ret
        end
        ; Simplified inner loop logic for brevity
        y = add(y 1)
    end
end

; 18. Chat server
import "std/os"
fn start_server() do
    let fd i32 = socket_create()
    let success bool = socket_bind(fd 65432)
    if success do
        socket_listen(fd)
    end
end

