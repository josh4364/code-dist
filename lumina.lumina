; 11. Launch rocket
fn launch_rocket() do
    mut t i32 = 10
    loop do
        let done bool = less_than(t 0)
        if done do
            break
        end
        print("T-minus ")
        print(t)
        t = subtract(t 1)
    end
    print("Liftoff!")
end

; 12. NKT Law
fn nkt_law(t f64 t_env f64 t_init f64 k f64) f64 do
    let diff f64 = subtract(t_init t_env)
    let kt f64 = multiply(k t)
    let neg_kt f64 = subtract(0.0 kt)
    let exponent f64 = exp(neg_kt)
    let term2 f64 = multiply(diff exponent)
    let result f64 = add(t_env term2)
    ret result
end

