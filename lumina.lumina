; 9. 100 doors
fn hundred_doors() do
    let doors array bool = new array bool(101)
    mut i i32 = 1
    loop do
        let i_done bool = greater_than(i 100)
        if i_done do
            break
        end
        mut j i32 = i
        loop do
            let j_done bool = greater_than(j 100)
            if j_done do
                break
            end
            let current bool = index(doors j)
            let toggled bool = not(current)
            set_index(doors j toggled)
            j = add(j i)
        end
        i = add(i 1)
    end
end

